node_modules/

# Keep android/ and ios/ committed once generated via 'cap add'.
# Ignore generated artifacts + secrets only:

# Generated build artifacts
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/captures/
android/app/release/
ios/App/build/
ios/App/Pods/
ios/App/DerivedData/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/

# Capacitor sync output (regenerated by cap sync)
android/app/src/main/assets/public/
ios/App/App/public/

# Generated assets cache from `capacitor-assets generate`
resources/.cache/

# Signing secrets — never commit
*.keystore
*.jks
android/keystore.properties
android/app/release.keystore
google-services.json
GoogleService-Info.plist
ios/App/App.entitlements.local
