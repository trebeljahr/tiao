node_modules/

# Capacitor-managed native projects are generated by `cap add android`
# and `cap add ios` on first bootstrap (see README.md). Once they exist
# they SHOULD be checked in — Gradle plugins, signing config, plist
# tweaks all live there. The patterns below cover only the build
# artifacts those projects produce locally so they don't bloat git.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
ios/App/build/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/

# Generated assets cache from `capacitor-assets generate`
resources/.cache/
