# Copy to keystore.properties (git-ignored) for local signed release builds.
# The ANDROID_KEYSTORE_PATH / ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS /
# ANDROID_KEY_PASSWORD environment variables override this file (CI uses them).
# A relative storeFile is resolved from android/app/.
storeFile=/absolute/path/to/tiao-upload.keystore
storePassword=CHANGE_ME
keyAlias=tiao
keyPassword=CHANGE_ME
