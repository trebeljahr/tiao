{
  "name": "tiao-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build --webpack && node scripts/finalize-web-export.mjs",
    "build:desktop": "NEXT_PUBLIC_PLATFORM=desktop next build --webpack",
    "build:mobile": "NEXT_PUBLIC_PLATFORM=mobile next build --webpack",
    "size": "node scripts/report-bundle-size.mjs",
    "start": "node serve-export.mjs",
    "typecheck": "next typegen && tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@sentry/browser": "^11.10.0",
    "better-auth": "^1.7.17",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.1",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@serwist/next": "^9.5.13",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "serwist": "^9.5.13",
    "tailwindcss": "^4.3.4",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
