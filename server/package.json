{
  "name": "tiao-server",
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node dist/server/index.js",
    "dev": "NODE_ENV=development NODE_OPTIONS='--no-deprecation --no-warnings' node --watch --import tsx index.ts",
    "dev:e2e": "NODE_ENV=test NODE_OPTIONS='--no-warnings' node --watch --import tsx index.ts",
    "test": "NODE_ENV=test npm run build && NODE_ENV=test NODE_OPTIONS='--no-deprecation' node --test --test-reporter=spec dist/server/tests/*.test.js",
    "test:integration": "NODE_ENV=test npm run build && NODE_ENV=test NODE_OPTIONS='--no-deprecation' node --test --test-reporter=spec dist/server/tests/integration/*.test.js",
    "prod": "pm2 restart ecosystem.config.js"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@openpanel/sdk": "^1.3.1",
    "@sentry/node": "^10.75.3",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.6",
    "bullmq": "^5.81.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jimp": "^1.6.0",
    "mongodb": "^6.21.0",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.30.0",
    "stripe": "^22.6.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.14",
    "swagger-jsdoc": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
