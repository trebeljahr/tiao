{
  "name": "tiao-server",
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node dist/server/index.js",
    "dev": "NODE_ENV=development NODE_OPTIONS='--no-deprecation --no-warnings' node --watch --import tsx index.ts",
    "dev:e2e": "NODE_ENV=test NODE_OPTIONS='--no-warnings' node --watch --import tsx index.ts",
    "test": "NODE_ENV=test npm run build && NODE_ENV=test NODE_OPTIONS='--no-deprecation' node --test --test-reporter=spec dist/server/tests/*.test.js",
    "test:integration": "NODE_ENV=test npm run build && NODE_ENV=test NODE_OPTIONS='--no-deprecation' node --test --test-reporter=spec dist/server/tests/integration/*.test.js",
    "prod": "pm2 restart ecosystem.config.js"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/node": "^11.10.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.17",
    "bullmq": "^6.7.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jimp": "^1.6.0",
    "mongodb": "^7.8.0",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "rate-limit-redis": "^6.0.2",
    "satori": "0.63.2",
    "stripe": "^23.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/ws": "^8.18.2",
    "nodemon": "^3.1.14",
    "swagger-jsdoc": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "body-parser@2": "2.4.0",
      "fast-uri@3": "^3.1.9",
      "fflate@0.7": "^0.7.5",
      "glob@11": "^14.0.2",
      "minimatch@10": "^11.0.1",
      "zod@3": "4.6.6",
      "zod@4": "4.6.6"
    }
  },
  "packageManager": "pnpm@10.33.2"
}
