{
  "compilerOptions": {
    "target": "es6",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "commonjs",
    "rootDir": "..",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "../shared/**/*.test.ts"]
}
