# For local development with docker-compose, no .env file is needed.
# server/.env.development ships with working defaults for the local
# MinIO + MongoDB containers started by `npm run dev:infra`.
# Only create this .env file if you need custom/production settings.

PORT=3000
FRONTEND_URL=https://tiao.example.com
MONGODB_URI=mongodb://user:password@mongo:27017/tiao
TOKEN_SECRET=replace-me
S3_BUCKET_NAME=tiao-assets
S3_PUBLIC_URL=https://assets.example.com
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Optional for S3-compatible storage like MinIO, Cloudflare R2, or Hetzner Object Storage.
# S3_ENDPOINT=https://minio.example.com
# S3_FORCE_PATH_STYLE=true

# Backwards-compatible alias if you still use CloudFront naming.
# CLOUDFRONT_URL=https://assets.example.com

# Required: Redis for distributed matchmaking, locks, timers, broadcasts,
# and rate limiting. The server refuses to start without it outside of
# tests (NODE_ENV=test). `npm run dev` auto-starts a Redis container via
# docker-compose.dev.yml; this URL matches that container.
REDIS_URL=redis://127.0.0.1:6379

# --- Email (password reset, verification, email change, moderation alert) ---
# server/auth/email.ts picks one transport, in this order:
#   1. Listmonk /api/tx, when all five LISTMONK_* values are set. Listmonk
#      relays through its SMTP settings (Amazon SES for playtiao.com).
#   2. Resend, when RESEND_API_KEY is set.
#   3. Neither: emails are logged to the console instead of sent.
# A partial LISTMONK_* set is ignored (the boot log names what is missing),
# so completing it is the whole cutover from Resend and removing one value
# rolls it back.
#
# Listmonk answers 200 as soon as it has queued the message, before SES sees
# it. An address SES refuses shows up only in Listmonk → Settings → Logs.
#
# LISTMONK_URL=https://listmonk.example.com
# LISTMONK_API_USER=tiao            # API user whose role grants only tx:send
# LISTMONK_API_TOKEN=
# LISTMONK_TX_TEMPLATE_ID=          # tx template: subject {{ .Tx.Data.subject }}, body {{ .Tx.Data.body | Safe }}
# LISTMONK_REPLY_TO=Tiao <hi@playtiao.com>
# LISTMONK_FROM=Tiao <newsletter@mail.example.com>   # must be inside the SES-verified domain
#
# RESEND_API_KEY=
# EMAIL_FROM=Tiao <noreply@example.com>           # Resend only

# --- OpenPanel (server-side analytics) ---------------------------------------
# Required to enable server-side tracking of authoritative events (signups,
# game finishes, payments). When any of the three is missing the server SDK
# boots disabled and all calls become no-ops — safe default for tests & CI.
# The client secret must NEVER appear in the client bundle; keep it here only.
# OPENPANEL_CLIENT_ID=
# OPENPANEL_CLIENT_SECRET=
# OPENPANEL_API_URL=
# Optional. Set to "true" to also send from NODE_ENV=development.
# OPENPANEL_ENABLE_IN_DEV=false
#
# Read-mode credentials for the Export API (used by the GDPR data export to
# include analytics events). Create a separate "read" client in the OpenPanel
# dashboard — the default "write" client doesn't have Export API access.
# When missing, data exports still work but won't include analytics events.
# OPENPANEL_READ_CLIENT_ID=
# OPENPANEL_READ_CLIENT_SECRET=
#
# Dev/prod separation: To keep dev events out of prod analytics, create a
# separate OpenPanel project for development and use its CLIENT_ID here
# (or in .env.development). Events are tagged with an `environment` global
# property, but a separate project avoids polluting dashboards entirely.

# --- GlitchTip (error monitoring) -------------------------------------------
# Sentry-compatible DSN pointing at your self-hosted GlitchTip instance.
# When unset the error reporting SDK boots disabled — safe for dev/CI/test.
# GLITCHTIP_DSN=https://key@glitchtip.trebeljahr.com/1

# --- Discord (community feed) -----------------------------------------------
# Optional webhook URLs, one per announcement feature. Each is a no-op when
# unset — safe for dev/CI/test. Delivery errors are logged, never surfaced.
#
# Announces achievement unlocks ("🏆 <player> unlocked '<achievement>'").
# Trivial first-session achievements are never announced — see
# DISCORD_SILENT_ACHIEVEMENT_IDS in shared/src/achievements.ts.
# DISCORD_WEBHOOK_ACHIEVEMENTS=https://discord.com/api/webhooks/<id>/<token>
#
# Announces every finished multiplayer game
# ("⚔️ Alice (ELO 1520) vs Bob (ELO 1480). Winner: Alice in 42 moves.").
# Rate-limited to one post per 30s; extra posts are dropped, not queued.
# DISCORD_WEBHOOK_GAME_RESULTS=https://discord.com/api/webhooks/<id>/<token>

# --- Discord leaderboard -----------------------------------------------------
# Once a day (06:00 UTC, plus once at boot) the server rewrites a pinned
# "top 10 by rating" message in the game-results channel. Both values are
# required to enable it; leave them unset and the job never starts.
#
# DISCORD_BOT_TOKEN: the bot user's token from the Discord Developer Portal
# (Bot → Reset Token). The bot needs "Send Messages", "Read Message History"
# and "Manage Messages" (for pinning) in the target channel.
# DISCORD_CHANNEL_GAME_RESULTS: the channel id (Developer Mode → right-click
# the channel → Copy Channel ID). The pinned message id is remembered in the
# AppSetting collection, so deleting the message just makes the next run
# post and pin a fresh one.
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_GAME_RESULTS=

# --- Discord bot (slash commands) ------------------------------------------
# Optional. The /discord/interactions endpoint and the register script are
# only active when BOTH DISCORD_BOT_TOKEN (above) and DISCORD_PUBLIC_KEY are
# set; otherwise the route answers 404. All values come from the application's
# page at https://discord.com/developers/applications.
# DISCORD_PUBLIC_KEY=           # General Information → Public Key (64 hex chars)
# DISCORD_APPLICATION_ID=       # General Information → Application ID
# Optional: register commands for one guild only (instant) instead of
# globally (up to an hour to propagate). Handy while testing.
# DISCORD_GUILD_ID=
# Optional: JSON file backing /puzzle. Missing file → "no puzzle configured".
# Shape: { "title"?, "weekOf"?, "position", "sideToMove": "white"|"black",
#          "difficulty", "imageUrl" }
# DISCORD_PUZZLE_FILE=/data/tiao/puzzle-of-the-week.json
#
# Set "Interactions Endpoint URL" in the portal to
# https://<api-host>/api/discord/interactions, then run
# `pnpm discord:register` (add --dry-run to preview the payload).

# --- Database backups (scripts/db-backup.sh) --------------------------------
# Only needed on the host that runs the backup job, not by the server itself.
# The script dumps MONGODB_URI (above) with mongodump, uploads the gzipped
# archive with rclone and prunes old copies. See scripts/README.md.
#
# rclone destination "<remote>:<bucket>[/<path>]". The remote must already be
# set up with `rclone config` (e.g. Backblaze B2 or Hetzner Object Storage).
# BACKUP_REMOTE=b2:tiao-backups
# Delete remote backups older than N days after each successful upload.
# Default 30. Set 0 to keep everything.
# BACKUP_KEEP_DAYS=30
# Optional archive file name prefix (default "tiao") and temp dir override.
# BACKUP_PREFIX=tiao
# BACKUP_TMP_DIR=/var/tmp

# Shop payments: use test credentials locally and live credentials in production.
# Production requires both a live Stripe key (sk_live_ or rk_live_) and the
# signing secret for its live /api/shop/webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Steam Microtransactions (Steam desktop build). Publisher Web API key from
# Steamworks → Users & Permissions → Manage Groups → Web API key, with the
# Microtransaction permission. Never ship it to a client. Leave the key empty
# to disable Steam purchases. STEAM_MICROTXN_SANDBOX=true uses
# ISteamMicroTxnSandbox (no charge) and is refused when NODE_ENV=production.
STEAM_PUBLISHER_WEB_API_KEY=
STEAM_APPID=5035580
STEAM_MICROTXN_SANDBOX=false
