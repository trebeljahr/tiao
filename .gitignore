# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
**/.pnp
.pnp.js

# testing
**/coverage
playwright-report/
test-results/

# next.js
**/.next/
# Suffixed Next dist dirs:
#   .next-desktop     — static export for the Electron desktop build
#   .next-<port>      — per-port persistent Turbopack cache in
#                       scripts/dev.mjs dev:parallel mode
**/.next-*/
**/out/
**/next-env.d.ts

# service worker (generated by Serwist at build time)
client/public/sw.js
client/public/sw.js.map
client/public/swe-worker-*.js

# production
**/build
# electron-builder reads desktop/build/{entitlements.mac.plist,icon.icns,icon.ico,icon.png}
# at package time — these are source files, not build output. Keep them tracked.
!desktop/build/
!desktop/build/**

# misc
**/.DS_Store
**/*.pem

# debug
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# local env files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
# per-machine overrides read by docker-compose.dev-traefik.yml
# (OAuth creds, GlitchTip DSN, etc.) — never commit
**/.env.docker

# vercel
**/.vercel

# docusaurus
**/.docusaurus
docs-site/source-links.json

# build artifacts
*.tsbuildinfo

# husky runtime shims (regenerated by npm install)
.husky/_/

# claude code
.claude/settings.local.json
.claude/worktrees/

# standard defaults (mirrors ~/.config/git/ignore)
.DS_Store
._*
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
.idea/
.cursor/
*.swp
*~
node_modules/
__pycache__/
*.pyc
.venv/
venv/
*.log

# env files (mirrors ~/.config/git/ignore — defense in depth)
.env
.env.local
.env.dev
.env.development
.env.production
.env.staging
.env.test
.envrc.local
.vercel/

# Generated Steam upload assets (regenerate with `pnpm steam:icons`)
/build/

# local-only output of the secret/history audit (see .gitleaks.toml)
SECURITY-AUDIT.md

# Store screenshot sets per size (scripts/app-store-screenshots.mjs). Regenerate; too large to commit.
output/playwright/store-gameplay/*/
output/playwright/store-ui/*/
!output/playwright/store-ui/avatars/
