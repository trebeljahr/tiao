{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 3001",
    "generate:source-links": "node scripts/generate-source-links.mjs",
    "validate:source-links": "node scripts/validate-source-links.mjs",
    "sync:architecture": "node scripts/sync-architecture.mjs",
    "build": "npm run sync:architecture && npm run generate:source-links && docusaurus build && npm run validate:source-links",
    "generate:api-docs": "docusaurus gen-api-docs tiao",
    "clean:api-docs": "docusaurus clean-api-docs tiao",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "docusaurus-plugin-openapi-docs": "^5.2.0",
    "docusaurus-theme-openapi-docs": "^5.2.0",
    "path-browserify": "^1.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "~5.6.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@4.3.0": "4.3.2",
      "yaml@1.10.2": "1.10.3",
      "immutable@5.1.5": "5.1.8",
      "colord@2.9.3": "2.9.4",
      "serialize-javascript@6.0.2": "7.0.7",
      "uuid@8.3.2": "11.1.1"
    }
  }
}
