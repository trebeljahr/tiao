<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store build, main app only. Helpers use entitlements.mas.inherit.plist.
  - application-groups: Electron names its sandboxed IPC after <team>.<bundle id>.
  - network.client: HTTPS + WebSocket to api.playtiao.com. No server: OAuth
    returns through the tiao:// URL scheme (CFBundleURLTypes), not a loopback port.
  - files.user-selected.read-only: the profile picture file picker.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>4BHY8H2J25.com.ricoslabs.tiao</string>
  </array>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
</dict>
</plist>
