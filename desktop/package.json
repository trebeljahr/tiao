{
  "name": "tiao-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron wrapper for the Tiao desktop app — Phase 3a standalone build.",
  "main": "main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev:ensure-bundle && electron .",
    "dev:fresh": "npm run dev:rebuild-client && electron .",
    "dev:prod": "TIAO_API_URL=https://api.playtiao.com npm run dev",
    "dev:hmr": "TIAO_DEV_RENDERER_URL=${TIAO_DEV_RENDERER_URL:-http://localhost:3000/en/} electron .",
    "dev:ensure-bundle": "test -f client-bundle/en/index.html || npm run dev:build-client",
    "dev:build-client": "npm --prefix ../client run build:desktop && rm -rf client-bundle && cp -R ../client/.next-desktop/. client-bundle",
    "dev:rebuild-client": "npm run dev:build-client",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.cjs'",
    "package": "electron-builder -p never",
    "package:all": "electron-builder -mwl -p never",
    "package:steam": "electron-builder -p never --config.extraMetadata.steamBuild=true --config.extraMetadata.steamAppId=${TIAO_STEAM_APPID:-480}",
    "release": "./scripts/release.sh",
    "release:tag": "bash scripts/release-tag.sh",
    "release:tag:push": "bash scripts/release-tag.sh --push",
    "itch:push:mac": "butler push --userversion $npm_package_version dist/mac-universal/Tiao.app $ITCH_USER/$ITCH_GAME:osx",
    "itch:push:win": "butler push --userversion $npm_package_version dist/win-unpacked $ITCH_USER/$ITCH_GAME:windows",
    "itch:push:linux": "butler push --userversion $npm_package_version dist/*.AppImage $ITCH_USER/$ITCH_GAME:linux"
  },
  "dependencies": {
    "@sentry/node": "^10.48.0",
    "electron-updater": "^6.3.0",
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/node": "^22.15.0",
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "site.playtiao.desktop",
    "productName": "Tiao",
    "copyright": "Copyright © 2026 Tiao contributors",
    "asar": true,
    "afterSign": "scripts/notarize.cjs",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*.cjs",
      "package.json",
      "steam_appid.txt",
      "!node_modules/.cache/**",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/steamworks.js/**"
    ],
    "extraResources": [
      {
        "from": "client-bundle",
        "to": "client-bundle",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.board-games",
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "assets/icon.png",
      "synopsis": "A beautiful abstract strategy board game.",
      "description": "Play Tiao online or offline — local 2-player, AI opponent, tutorial, and multiplayer when connected."
    },
    "protocols": [
      {
        "name": "Tiao",
        "schemes": [
          "tiao"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "trebeljahr",
      "repo": "tiao",
      "releaseType": "draft"
    }
  }
}
