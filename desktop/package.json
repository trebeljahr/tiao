{
  "name": "tiao-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Tauri wrapper for the Tiao desktop app.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/tauri/dev.mjs",
    "dev:fresh": "node scripts/tauri/dev.mjs --fresh",
    "dev:prod": "TIAO_API_URL=https://api.playtiao.com node scripts/tauri/dev.mjs",
    "dev:build-client": "node scripts/tauri/stage.mjs",
    "dev:rebuild-client": "node scripts/tauri/stage.mjs",
    "typecheck": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "test": "pnpm test:js && pnpm test:native",
    "package": "node scripts/tauri/package.mjs",
    "package:steam": "TIAO_DISTRIBUTION_CHANNEL=steam node scripts/tauri/package.mjs",
    "package:steam-demo": "TIAO_DISTRIBUTION_CHANNEL=steam-demo node scripts/tauri/package.mjs",
    "package:mas": "TIAO_DISTRIBUTION_CHANNEL=mas node scripts/tauri/package.mjs",
    "package:msstore": "TIAO_DISTRIBUTION_CHANNEL=msstore node scripts/tauri/package.mjs",
    "release": "./scripts/release.sh",
    "version:check": "node scripts/release/version.mjs --check",
    "version:set": "node scripts/release/version.mjs",
    "release:check": "node --test 'scripts/tauri/*.test.mjs'",
    "test:js": "node --test --test-concurrency=1 'scripts/tauri/*.test.mjs' 'scripts/release/*.test.mjs' 'src/routes.test.cjs' '../scripts/steam-local.test.mjs'",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --locked"
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0"
  }
}
