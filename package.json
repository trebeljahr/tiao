{
  "name": "tiao-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.14.x"
  },
  "scripts": {
    "postinstall": "pnpm --prefix ./client install && pnpm --prefix ./server install && pnpm --prefix docs-site install && (test \"$SKIP_DESKTOP\" = \"1\" || ppnpm --prefix ./desktop install)",
    "build": "concurrently --kill-others-on-fail -n client,server -c blue,green \"npm:build:client\" \"npm:build:server\"",
    "build:client": "pnpm --prefix ./client run build",
    "build:server": "pnpm --prefix ./server run build",
    "dev": "node scripts/dev.mjs",
    "dev:parallel": "DEV_PARALLEL=1 node scripts/dev.mjs",
    "dev:fixed": "node scripts/dev.mjs --fixed",
    "dev:lan": "node scripts/dev.mjs --fixed --lan",
    "dev:docs": "node scripts/dev.mjs --docs",
    "dev:docs:fixed": "node scripts/dev.mjs --fixed --docs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:desktop:prod": "ppnpm --prefix ./desktop run dev:prod",
    "typecheck": "concurrently --kill-others-on-fail -n client,server -c blue,green \"npm:typecheck:client\" \"npm:typecheck:server\"",
    "typecheck:client": "pnpm --prefix ./client run typecheck",
    "typecheck:server": "pnpm --prefix ./server run typecheck",
    "eslint": "concurrently --kill-others-on-fail -n client,server -c blue,green \"npm:eslint:client\" \"npm:eslint:server\"",
    "eslint:client": "pnpm --prefix ./client run eslint",
    "eslint:server": "pnpm --prefix ./server run eslint",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "concurrently -n server,client,desktop -c green,blue,magenta \"pnpm --prefix ./server test\" \"pnpm --prefix ./client test\" \"ppnpm --prefix ./desktop test\"",
    "test:integration": "pnpm --prefix ./server run test:integration",
    "test:e2e": "EMIT_SOURCE_MAPS=1 pnpm --prefix ./client run build && playwright test",
    "client": "pnpm --prefix ./client run dev",
    "server": "pnpm --prefix ./server run dev",
    "docs": "pnpm --prefix docs-site start",
    "docs:build": "tsx server/scripts/generate-openapi.ts && pnpm --prefix docs-site run generate:api-docs && pnpm --prefix docs-site run build",
    "dev:infra": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:infra:stop": "docker-compose -f docker-compose.dev.yml down",
    "dev:infra:reset": "docker-compose -f docker-compose.dev.yml down -v",
    "dev:docker": "docker-compose -f docker-compose.dev.yml -f docker-compose.dev-traefik.yml up -d --build",
    "dev:docker:logs": "docker-compose -f docker-compose.dev.yml -f docker-compose.dev-traefik.yml logs -f tiao-client tiao-server traefik",
    "dev:docker:stop": "docker-compose -f docker-compose.dev.yml -f docker-compose.dev-traefik.yml down",
    "dev:docker:rebuild": "docker-compose -f docker-compose.dev.yml -f docker-compose.dev-traefik.yml build --no-cache tiao-client tiao-server",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css}": ["biome check --write --no-errors-on-unmatched"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.59.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mongodb": "^6.21.0"
  }
}
