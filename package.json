{
  "name": "tiao-monorepo",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "pnpm --dir ./client install && pnpm --dir ./server install && pnpm --dir docs-site install && (test \"$SKIP_DESKTOP\" = \"1\" || pnpm --dir ./desktop install) && (test \"$SKIP_MOBILE\" = \"1\" || pnpm --dir ./mobile install)",
    "build": "concurrently --kill-others-on-fail -n client,server -c blue,green \"npm:build:client\" \"npm:build:server\"",
    "build:client": "pnpm --dir ./client run build",
    "build:server": "pnpm --dir ./server run build",
    "dev": "node scripts/dev.mjs",
    "dev:parallel": "DEV_PARALLEL=1 node scripts/dev.mjs",
    "dev:fixed": "node scripts/dev.mjs --fixed",
    "dev:lan": "node scripts/dev.mjs --fixed --lan",
    "dev:docs": "node scripts/dev.mjs --docs",
    "dev:docs:fixed": "node scripts/dev.mjs --fixed --docs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "steam:achievements": "node scripts/steam-achievements.mjs",
    "steam:achievements:check": "node scripts/steam-achievements.mjs --check",
    "steam:icons": "node scripts/steam-achievement-icons.mjs",
    "discord:register": "pnpm --dir ./server exec tsx ../scripts/discord-register-commands.ts",
    "setup:discord": "tsx scripts/discord-setup.ts",
    "dev:desktop:prod": "pnpm --dir ./desktop run dev:prod",
    "typecheck": "concurrently --kill-others-on-fail -n client,server -c blue,green \"npm:typecheck:client\" \"npm:typecheck:server\"",
    "typecheck:client": "pnpm --dir ./client run typecheck",
    "typecheck:server": "pnpm --dir ./server run typecheck",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "concurrently -n server,client,desktop -c green,blue,magenta \"pnpm --dir ./server test\" \"pnpm --dir ./client test\" \"pnpm --dir ./desktop test\"",
    "test:integration": "pnpm --dir ./server run test:integration",
    "test:e2e": "EMIT_SOURCE_MAPS=1 pnpm --dir ./client run build && playwright test",
    "client": "pnpm --dir ./client run dev",
    "server": "pnpm --dir ./server run dev",
    "docs": "pnpm --dir docs-site start",
    "docs:build": "tsx server/scripts/generate-openapi.ts && pnpm --dir docs-site run generate:api-docs && pnpm --dir docs-site run build",
    "dev:infra": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:infra:stop": "docker-compose -f docker-compose.dev.yml down",
    "dev:infra:reset": "docker-compose -f docker-compose.dev.yml down -v",
    "dev:docker": "docker-compose -f docker-compose.dev.yml -f docker-compose.dev-traefik.yml up -d --build",
    "dev:docker:logs": "docker-compose -f docker-compose.dev.yml -f docker-compose.dev-traefik.yml logs -f tiao-client tiao-server traefik",
    "dev:docker:stop": "docker-compose -f docker-compose.dev.yml -f docker-compose.dev-traefik.yml down",
    "dev:docker:rebuild": "docker-compose -f docker-compose.dev.yml -f docker-compose.dev-traefik.yml build --no-cache tiao-client tiao-server",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "scan:secrets": "gitleaks detect --no-banner --no-git --config .gitleaks.toml",
    "check": "biome check --write .",
    "prepare": "husky",
    "backup:status": "hatchkit backup status --project tiao",
    "backup:list": "hatchkit backup snapshots --project tiao",
    "backup:restore": "hatchkit backup restore --project tiao"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@playwright/test": "^1.59.1",
    "concurrently": "^9.2.1",
    "discord.js": "^14.27.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mongodb": "^6.21.0",
    "tsx": "^4.23.15"
  }
}
